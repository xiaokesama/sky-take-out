<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">

    <insert id="insert">
        INSERT INTO setmeal_dish (setmeal_id, dish_id,name, price, copies) VALUES
            (#{setmealId}, #{dishId}, #{name}, #{price}, #{copies})
    </insert>

    <delete id="deleteBySetmealId">
        DELETE FROM setmeal_dish WHERE setmeal_id = #{setmealId}
    </delete>

    <delete id="deleteBySetmealIds">
        DELETE FROM setmeal_dish WHERE setmeal_id IN
        <foreach collection="setmealIds" item="setmealId" open="(" separator="," close=")">
            #{setmealId}
        </foreach>
    </delete>

    <select id="selectByDishIds" resultType="com.sky.entity.SetmealDish">
        SELECT * FROM setmeal_dish WHERE dish_id IN
        <foreach collection="dishIds" item="dishId" open="(" separator="," close=")">
            #{dishId}
        </foreach>
    </select>

</mapper>
